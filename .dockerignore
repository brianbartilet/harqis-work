# Secrets — never bake into the image. Mount .env/ as a volume at runtime.
.env/
**/.env
**/.env.*

# Local Python state
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Editor / IDE
.idea/
.vscode/
.run/

# VCS
.git/
.github/

# Build/dist artifacts
dist/
build/
*.tgz

# Logs and runtime droppings (keep the image clean)
*.log*
logs/
screenshots/
scripts/app*.log
celerybeat-schedule.db
*pid.*

# Docs — runtime image doesn't need them
docs/
*.md
!README.md

# Hermes agent state — host-only, never inside the image
.hermes/
# OpenClaw agent state (deprecated) — host-only, never inside the image
.openclaw/
# Private host configuration and runtime data (Git ignores do not protect builds).
machines.local.toml
fork-fleet.local.toml
*.local.toml.new
machines.toml.new
.harqis-data/
.codex/
.claude/
.tmp/
outputs/
results/
node_modules/
.venv.backup-*/
.venv.failed-*/
apps/own_tracks/recorder_store/
apps/own_tracks/mosquitto/data/
apps/own_tracks/mosquitto/log/
*.db
*.sqlite
*.sqlite3
*.sqlite3-*
celerybeat-schedule*
*.bak*
*.zip*
