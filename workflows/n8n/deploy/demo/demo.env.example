# Template only. Store the populated file outside the repository.
# Select and verify an exact stable release >= 2.35.0 before deployment.
N8N_DEMO_VERSION=2.44.6
N8N_DEMO_HOST=n8n-demo.harqis-solutions.com
N8N_DEMO_PORT=5679
# Set to the actual trusted reverse-proxy hop count.
N8N_DEMO_PROXY_HOPS=1
# Generate a unique random key; retain it with backups of the demo_data volume.
N8N_DEMO_ENCRYPTION_KEY=
# Leave empty for manual invite links; set smtp once all SMTP fields are ready.
# Password reset emails are unavailable until SMTP is configured.
N8N_DEMO_EMAIL_MODE=
N8N_DEMO_SMTP_HOST=
N8N_DEMO_SMTP_PORT=465
N8N_DEMO_SMTP_USER=
N8N_DEMO_SMTP_PASS=
N8N_DEMO_SMTP_SENDER=
N8N_DEMO_SMTP_SSL=true
# This stack does not publish DNS or configure TLS.
# Route the chosen HTTPS hostname to the host's loopback port 5679.
# A proxy in another container needs an explicitly configured shared network;
# its localhost does not refer to this host or the n8n container.
# Create the owner account through a restricted HTTPS route before public access.
# Invite members under Settings > Users after verifying SMTP delivery.
# Community accounts have personal workflows; shared editing is plan-dependent.
